# Copy to .env; shell variables take precedence. No shell expansion is performed.
OPENAI_API_KEY=
EXPLAIN_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
EXPLAIN_REWRITE_MODEL=gpt-4.1-mini
# Default voice: OpenAI marin with warm, friendly delivery.
# Optional alternative: edge with EXPLAIN_VOICE=ru-RU-SvetlanaNeural.
EXPLAIN_TTS_PROVIDER=openai
# Blank selects the default for the provider (marin or ru-RU-SvetlanaNeural).
EXPLAIN_VOICE=
EXPLAIN_TTS_MODEL=gpt-4o-mini-tts
# Optional delivery direction (blank uses the default friendly style).
EXPLAIN_TTS_INSTRUCTIONS=
